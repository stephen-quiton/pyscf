# kmf.mo_energy = mo_energy_ss


# Update the MO energies in the KMP2 object

# mypt = mp.KMP2(kmf)
# mypt.mo_energy = mo_energy_ss

mypt = kmf.MP2()
assert mymp.__class__.__name__ == 'KMP2_direct'
mypt.set_frozen()

e_corr, _ = mypt.kernel(with_t2=False)
print("KMP2 energy (per unit cell) =", mypt.e_tot)
e_corr_ss = mypt.e_corr_ss
e_corr_os = mypt.e_corr_os
edi = e_corr_os*2.0
exi = e_corr_ss - e_corr_os
print("Direct MP2 energy (per unit cell) =", edi)
print("Exchange MP2 energy (per unit cell) =", exi)

# Initialize MP2SS with parameters
mp2ss = MP2SS(
    kmf=kmf,
    kmp=mypt,
    t2=None,
    auxfunc_direct="Gauss",
    auxfunc_direct_q2="Gauss",
    auxfunc_direct_q4="Gauss",
    auxfunc_exchange="Gauss",
    fit_with_coul=True,
    fit_method='scipy_least_squares',
    sq_inversion_symm=True,
    pair_density_eval_grid='becke',
    correct_q2_q4_separately=True,
    fit_with_coul_q4=True,
    fit_with_coul_q2=True,
    line_sampling=True,
    t2_store_type='kikj_Lov',
    laplace=True,
)

# Compute the MP2 correction
print("Computing MP2 singularity subtraction correction...")
# p = Profiler()
# p.start()


correction = mp2ss.compute_correction(direct=True,exchange=True)
# p.stop()
# p.open_in_browser()
print(f"\nFinal MP2 direct correction: {correction.mp2ss_direct_correction}")
print(f"\nFinal MP2 exchange correction: {correction.mp2ss_exchange_correction}")   
