# Usage:
#   python mp2ss-vary-nk.py <xyz_file> <nk> <memory>
#
# Arguments:
#   xyz_file  : path to an extended XYZ file with lattice info in the comment
#               line (format written by cif_to_xyz.py / convert_these_cifs.py)
#   nk        : k-point sampling. Either:
#                 - a single integer N, for an isotropic NxNxN mesh
#                   e.g. "3"      -> [3, 3, 3]
#                 - three separated integers, for an anisotropic mesh
#                   e.g. "1,2,3"  -> [1, 2, 3]
#                        "1x2x3"  -> [1, 2, 3]
#   memory    : maximum memory for PySCF, with an optional K/M/G/T suffix
#               (e.g. "240G"). Converted to MB for cell.max_memory.
#
# The XYZ comment line must contain:
#   Lattice="a11 a12 a13  a21 a22 a23  a31 a32 a33"
# (angstrom, row vectors), as written by the companion CIF->XYZ scripts.

from pyscf.pbc import gto as pbcgto
from pyscf.pbc.scf import khf
from pyscf.pbc import df
from pyscf import lib
import os
import sys
from pyscf.pbc import mp

import numpy as np
import copy
import re


try:
    from fsec.singularity_subtraction import ExxSSQuarticExponential, MP2SS
except ModuleNotFoundError as err:
    if err.name != "fsec":
        raise
    script_dir = os.path.dirname(os.path.abspath(__file__))
    fsec_candidates = [
        os.path.join(script_dir, "fsec"),
        os.path.join(script_dir, "..", "fsec"),
        os.path.expanduser("~/home_dev/fsec"),
    ]
    for fsec_path in fsec_candidates:
        if os.path.isdir(os.path.join(fsec_path, "fsec")):
            sys.path.insert(0, fsec_path)
            break
    from fsec.singularity_subtraction import ExxSSQuarticExponential, MP2SS


# ---------------------------------------------------------------------------
# CLI arguments
# ---------------------------------------------------------------------------

if len(sys.argv) < 4:
    print("Usage: python mp2ss-vary-nk.py <xyz_file> <nk> <memory>")
    print('  <nk> may be a single integer for an isotropic NxNxN mesh,')
    print('  e.g. "3" -> [3, 3, 3], or three comma/x-separated integers')
    print('  for an anisotropic mesh, e.g. "1,2,3" or "1x2x3" -> [1, 2, 3].')
    print('  <memory> is converted to MB for PySCF, e.g. "240G".')
    sys.exit(1)

xyz_file = sys.argv[1]


def parse_nk_arg(nk_arg):
    """Parse the <nk> CLI argument into a 3-tuple of ints.

    Accepts:
      - a single integer, e.g. "3"                  -> (3, 3, 3)  (isotropic)
      - three separated integers, e.g. "1,2,3",
        "1x2x3", or "1 2 3"                          -> (1, 2, 3)  (anisotropic)
    """
    s = nk_arg.strip()
    for sep in (',', 'x', 'X', ' '):
        if sep in s:
            parts = [p for p in s.split(sep) if p]
            if len(parts) != 3:
                raise ValueError(
                    f"Could not parse nk argument '{nk_arg}': expected 3 "
                    f"integers separated by '{sep}', got {parts}"
                )
            return tuple(int(p) for p in parts)
    # No separator found -> isotropic single integer
    n = int(s)
    return (n, n, n)


def parse_memory_mb(memory_arg):
    """Convert a memory value with an optional K/M/G/T suffix to MB."""
    match = re.fullmatch(
        r'\s*(\d+(?:\.\d+)?)\s*([KMGT]?)B?\s*',
        memory_arg,
        flags=re.IGNORECASE,
    )
    if not match:
        raise ValueError(
            f"Could not parse memory argument '{memory_arg}'. "
            'Expected a number with an optional K/M/G/T suffix, e.g. "240G".'
        )

    value = float(match.group(1))
    unit = match.group(2).upper() or 'M'
    mb_factors = {'K': 1 / 1024, 'M': 1, 'G': 1024, 'T': 1024 ** 2}
    return value * mb_factors[unit]


nks = list(parse_nk_arg(sys.argv[2]))
max_memory_mb = parse_memory_mb(sys.argv[3])

cwd = os.getcwd()
lib.num_threads(os.getenv('OMP_NUM_THREADS'))


# ---------------------------------------------------------------------------
# Helper functions
# ---------------------------------------------------------------------------

def nk_output_str(nk):
    return '-nk' + 'x'.join(str(v) for v in nk)


def kecut_output_str(kecut):
    return '-kecut' + str(kecut)


def kecut_to_mesh_qcpbc(kecut, a):
    """QCPBC convention for kecut. kecut in hartree."""
    a_norm    = np.linalg.norm(a, axis=1)
    g_spacing = np.pi / np.sqrt(kecut)
    mesh      = 2 * np.ceil(a_norm / g_spacing).astype(int) + 1
    return mesh


def parse_xyz(xyz_path):
    """
    Parse an extended XYZ file produced by the companion CIF->XYZ scripts.

    Returns
    -------
    lattice : np.ndarray, shape (3, 3)
        Row vectors of the unit cell in angstrom.
    atom_str : str
        PySCF-style atom string  "El x y z\nEl x y z\n..."
    """
    with open(xyz_path) as f:
        lines = f.readlines()

    natom   = int(lines[0].strip())
    comment = lines[1]

    # Extract 3x3 lattice matrix from  Lattice="a11 a12 a13 ..."
    m = re.search(r'Lattice="([^"]+)"', comment)
    if not m:
        raise ValueError(
            f"No Lattice= field found in comment line of {xyz_path}.\n"
            f"Comment was: {comment.strip()}"
        )
    vals    = [float(x) for x in m.group(1).split()]
    lattice = np.array(vals).reshape(3, 3)

    # Build atom string
    atom_lines = []
    for line in lines[2:2 + natom]:
        parts = line.split()
        if len(parts) < 4:
            continue
        elem, x, y, z = parts[0], parts[1], parts[2], parts[3]
        atom_lines.append(f"{elem} {x} {y} {z}")
    atom_str = "\n".join(atom_lines)

    return lattice, atom_str


def build_cell_from_xyz(xyz_path, nk=(1,1,1), kecut=100,
                         wrap_around=True, with_gamma_point=True,
                         basis='ccpvdz', max_memory=None):
    """Build a PySCF PBC Cell from an extended XYZ file."""
    lattice, atom_str = parse_xyz(xyz_path)

    cell          = pbcgto.Cell()
    cell.unit     = 'Angstrom'
    cell.atom     = atom_str
    cell.a        = lattice
    cell.verbose  = 7
    cell.spin     = 0
    cell.charge   = 0
    cell.basis    = basis
    cell.precision = 1e-8
    cell.ke_cutoff = kecut
    if max_memory is not None:
        cell.max_memory = max_memory
    # cell.pseudo = 'gth-hf'

    cell.build()
    cell.omega = 0

    kpts = cell.make_kpts(nk, wrap_around=wrap_around,
                          with_gamma_point=with_gamma_point)
    return cell, kpts


# ---------------------------------------------------------------------------
# Build cell and run KHF + KMP2
# ---------------------------------------------------------------------------

print(f"XYZ file : {xyz_file}")
print(f"K-mesh   : {nks}")
print(f"Max memory: {max_memory_mb:g} MB")

cell, kpts = build_cell_from_xyz(
    xyz_file,
    nk=nks,
    kecut=250,
    with_gamma_point=True,
    basis='ccpvtz',
    max_memory=max_memory_mb,
)
cell.dimension = 3
cell.build()

Nk =np.prod(nks)
print('Kmesh:', nks)


# kmf = khf.KRHF(cell, kpts, exxdiv=None).rs_density_fit()


kmf = khf.KRHF(cell, kpts).rs_density_fit()
kmf.exxdiv = 'ewald'
kmf.with_df.direct = True
kmf.with_df.semidirect = False
kmf.with_df.ksym = 's2'
